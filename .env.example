# ================================
# GbSA Community Detection — تنظیمات
# این فایل را به .env کپی کنید و مقادیر را ست کنید
# ================================

# --- الگوریتم ---
GBSA_POPULATION_SIZE=20
GBSA_ITERATIONS=50
GBSA_DATASET_PATH=data/karate.gml

# --- LLM (AvalAI / OpenAI-compatible) ---
GAPGPT_ENABLED=true
GAPGPT_BASE_URL=https://api.avalai.ir/v1
GAPGPT_API_KEY=
GAPGPT_MODEL=deepseek-v4-flash
#GAPGPT_MODEL=gpt-4o-mini
#GAPGPT_MODEL=gpt-4o
GAPGPT_REQUEST_TIMEOUT=60

# --- Ollama لوکال (به‌جای AvalAI) ---
# در OS env ست کنید:
#   GBSA_LLM_PROVIDER=ollama
#   GBSA_LLM_MODEL=llama3.2
